# ----- App -----
APP_ENV=development
APP_NAME=email-automation
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production-min-16-chars

# ----- Database -----
# Inside docker compose use hostname `db`; for local-only use `localhost`.
DATABASE_URL=postgresql+asyncpg://emailagent:emailagent@db:5432/emailagent
ALEMBIC_DATABASE_URL=postgresql+asyncpg://emailagent:emailagent@localhost:5432/emailagent

# ----- Redis / Celery -----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ----- Vector DB (Chroma) -----
# In docker network: chroma:8000. On host (outside docker): localhost:8001.
CHROMA_HOST=chroma
CHROMA_PORT=8000

# ----- LLM (Anthropic) -----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ----- Gmail OAuth (phase 2) -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ----- Frontend (phase 5) -----
# OAuth callback redirects here on success with ?token=...&user_id=...&email=...
FRONTEND_URL=http://localhost:3000

# ----- Logging -----
LOG_LEVEL=INFO
LOG_FORMAT=json
